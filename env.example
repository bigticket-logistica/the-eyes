# Copia este archivo a .env y completa con tus valores de Supabase.
# Estos valores son PUBLICOS (van al frontend); la seguridad la da RLS.

VITE_SUPABASE_URL=https://psvdtgjvognbmxfvqbaa.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Chile (bigticket-cl). Mismos valores que CL_URL y CL_KEY de
# /root/.pnr_cl_env en el VPS de Chile. Sin estas dos, el selector de país
# no ofrece Chile y la torre funciona solo con México.
VITE_SUPABASE_CL_URL=https://tu-proyecto-cl.supabase.co
VITE_SUPABASE_CL_KEY=tu-anon-key-cl-aqui
